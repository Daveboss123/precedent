# ---------------------------------------------------------------------------
# Tatum — Sui mainnet RPC
# Create a free account at https://dashboard.tatum.io and copy an API key.
# The submission form also asks for your Tatum dashboard account ID.
# ---------------------------------------------------------------------------
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# Optional: pin the onchain badge to a specific memory write.
# A transaction digest is the strongest proof; an object ID is the fallback.
TATUM_VERIFY_DIGEST=
TATUM_VERIFY_OBJECT_ID=

# ---------------------------------------------------------------------------
# Walrus Memory — MAINNET
# Create an account + delegate key at https://memory.walrus.xyz
#
# MEMWAL_KEY          delegate private key (hex or suiprivkey1…)
# MEMWAL_ACCOUNT_ID   MemWalAccount object ID (0x + 64 hex)
# MEMWAL_AGENT_ID     delegate public key — this is what the submission form
#                     calls MEMWAL_AGENT_ID, not the account ID
# ---------------------------------------------------------------------------
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_AGENT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=precedent
